{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities the Inkwell window needs: native file pickers and revealing saved files in Finder.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path"
  ]
}
